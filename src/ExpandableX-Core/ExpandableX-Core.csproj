<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ExpandableX.Core</RootNamespace>
    <AssemblyName>ExpandableX-Core</AssemblyName>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>$(SPZ2_PERSISTENT)\mods\ExpandableX-Core</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ShapezShifter">
      <HintPath>$(SPZ2_SHIFTER)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>$(SPZ2_PATH)\..\..\..\..\workshop\content\2162800\3542712030\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>False</Private>
      <!-- MonoMod.RuntimeDetour ships its own copies of the nullable-annotation attributes
           (NotNullWhen, etc.) that also live in netstandard, so its types are aliased out of the
           global namespace to avoid CS0433 ambiguity. Reach it via `extern alias monomod` (only
           ExpandableXCoreMod needs it). -->
      <Aliases>monomod</Aliases>
    </Reference>

    <Reference Include="SPZGameAssembly">
      <HintPath>$(SPZ2_PATH)\SPZGameAssembly.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core">
      <HintPath>$(SPZ2_PATH)\Game.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Modding">
      <HintPath>$(SPZ2_PATH)\Game.Core.Modding.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Coordinates">
      <HintPath>$(SPZ2_PATH)\Game.Core.Coordinates.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Layout.Model">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Layout.Model.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Map.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Map.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Simulation">
      <HintPath>$(SPZ2_PATH)\Game.Core.Simulation.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Rendering">
      <HintPath>$(SPZ2_PATH)\Game.Core.Rendering.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Orchestration">
      <HintPath>$(SPZ2_PATH)\Game.Orchestration.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Interaction">
      <HintPath>$(SPZ2_PATH)\Game.Interaction.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Content.Features">
      <HintPath>$(SPZ2_PATH)\Game.Content.Features.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Content">
      <HintPath>$(SPZ2_PATH)\Game.Content.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Game.Core.Content">
      <HintPath>$(SPZ2_PATH)\Game.Core.Content.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core">
      <HintPath>$(SPZ2_PATH)\Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Core.Localization">
      <HintPath>$(SPZ2_PATH)\Core.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(SPZ2_PATH)\Unity.Mathematics.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SPZ2_PATH)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <PublicizeAll>true</PublicizeAll>
    <PublicizerClearCacheOnClean>true</PublicizerClearCacheOnClean>
  </PropertyGroup>

  <ItemGroup>
    <DoNotPublicize Include="SPZGameAssembly:BeltLaneRenderingDefinition" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <DoNotPublicize Include="SPZGameAssembly:BuildingDefinition" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <DoNotPublicize Include="Game.Core.Coordinates" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <DoNotPublicize Include="Game.Orchestration:ParentToolbarElementData" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
    <DoNotPublicize Include="Game.Orchestration:RootToolbarElementData" IncludeCompilerGeneratedMembers="false" IncludeVirtualMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Compile-time polyfills (IsExternalInit etc.) so modern C# works on
         netstandard2.1 with no runtime dependency. -->
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
